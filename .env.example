# SQLite file path (node:sqlite, no server needed). Use a persistent disk in production.
DATABASE_PATH=./data/booking.db

# REQUIRED: the salon owner's admin password (10+ chars). The /admin area refuses to log in without it.
ADMIN_PASSWORD=change-me-please-1234

# REQUIRED in production: 32+ random chars used to sign the admin session cookie. Generate: openssl rand -hex 32
SESSION_SECRET=change-me-dev-only-change-me-dev-only
